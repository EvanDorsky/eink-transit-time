# Site config for this display, read at build time by scripts/site_env.py.
# Copy to site.env (gitignored), fill in, and load it before building:
#   cp site.env.example site.env
#   set -a; . ./site.env; set +a; pio run
# GTFS stop ids come from the MTA static GTFS (stops.txt); BusTime stop ids
# from bustime.mta.info. All values are required; the build fails without them.

# Where the display is, for its weather (Open-Meteo). Optional, but leave
# these blank and the display shows NO weather (no icon, hi/lo, rain alert
# or hourly screen). Two decimals (~1 km) is plenty.
TRANSIT_LAT=                  # e.g. 40.71
TRANSIT_LON=                  # e.g. -74.01

TRANSIT_SUBWAY_STOP=          # home subway station, parent id (e.g. A12)
TRANSIT_XFER_STOP=            # flight mode: C -> A transfer platform, southbound (e.g. A12S)
TRANSIT_AIRPORT_SUBWAY_STOP=  # flight mode: A stop at the AirTrain, southbound
TRANSIT_LIRR_ORIGIN_STOP=     # flight mode: home LIRR station
TRANSIT_LIRR_JFK_STOP=        # flight mode: LIRR station at the AirTrain
TRANSIT_BUS_STOP_WEST=        # BusTime MonitoringRef, downtown-bound
TRANSIT_BUS_STOP_EAST=        # BusTime MonitoringRef, other direction

# Optional: line, feed and wording. Unset = the defaults in include/site.h
# (C/A on the ACE feed; rows "Manhattan", "Euclid", "Downtown", "Eastbound";
# bus badge "B25 B26"). Quote any value that contains a space.
#TRANSIT_SUBWAY_FEED=nyct%2Fgtfs-ace   # feed that carries both routes below
#TRANSIT_ROUTE_PRIMARY=C               # route shown normally (one letter/digit)
#TRANSIT_ROUTE_FALLBACK=A              # shown when the primary isn't running
#TRANSIT_LABEL_NORTH=Manhattan         # row labels, ~10 characters max
#TRANSIT_LABEL_SOUTH=Euclid
#TRANSIT_LABEL_BUS_WEST=Downtown
#TRANSIT_LABEL_BUS_EAST=Eastbound
#TRANSIT_BUS_BADGE="B25 B26"           # one or two bus route names
