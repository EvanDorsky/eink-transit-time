# Site config for this display, read at build time by scripts/site_env.py.
# Copy somewhere outside the repo, fill in, and load it before building:
#   set -a; . /path/to/site.env; set +a; pio run
# GTFS stop ids come from the MTA static GTFS (stops.txt); BusTime stop ids
# from bustime.mta.info. All values are required; the build fails without them.

TRANSIT_SUBWAY_STOP=          # home subway station, parent id (e.g. A12)
TRANSIT_XFER_STOP=            # flight mode: C -> A transfer platform, southbound (e.g. A12S)
TRANSIT_AIRPORT_SUBWAY_STOP=  # flight mode: A stop at the AirTrain, southbound
TRANSIT_LIRR_ORIGIN_STOP=     # flight mode: home LIRR station
TRANSIT_LIRR_JFK_STOP=        # flight mode: LIRR station at the AirTrain
TRANSIT_BUS_STOP_WEST=        # BusTime MonitoringRef, downtown-bound
TRANSIT_BUS_STOP_EAST=        # BusTime MonitoringRef, other direction
